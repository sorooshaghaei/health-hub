DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC

POSTGRES_DB=health_hub
POSTGRES_USER=health_hub
POSTGRES_PASSWORD=replace-this-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DEVICE_PAIRING_MAX_AGE=600
STAFF_SESSION_MAX_AGE=43200
STAFF_SESSION_INACTIVITY_AGE=7200
REAUTH_MAX_AGE=600
VERIFICATION_CODE_MAX_AGE=600
VERIFICATION_RESEND_MIN_AGE=60
VERIFICATION_MAX_ATTEMPTS=5
RECOVERY_GRANT_MAX_AGE=1800
ASSISTANT_SETUP_MAX_AGE=86400
PASSKEY_CHALLENGE_MAX_AGE=300
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Health Hub
WEBAUTHN_ORIGIN=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@health-hub.local
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
SMS_SENDER=

# Private Patient attachment storage. Keep this directory outside any public
# static/media web root. A cloud storage backend can replace FileSystemStorage
# without changing the attachment domain model or API.
PRIVATE_MEDIA_ROOT=private_media
PRIVATE_FILE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
PATIENT_ATTACHMENT_MAX_BYTES=104857600
PATIENT_ATTACHMENT_MAX_BATCH=10
PATIENT_ATTACHMENT_PAGE_SIZE=50
PATIENT_ATTACHMENT_DELETE_UNDO_SECONDS=5
